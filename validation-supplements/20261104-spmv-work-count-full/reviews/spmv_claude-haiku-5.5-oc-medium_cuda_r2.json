    {
      "file": "spmv/spmv.cpp",
      "ranges": [
        [
          1,
          387
        ]
      ],
      "claim": "The kernel assigns one warp per row, has lanes stride through the row's CSR interval, reduces and stores the row result. CLI iterations, numRows and sparsity determine the count/dimension/nItems; CSR and operands are initialized and copied. A pre-timing launch is followed by synchronization; the timed loop calls spmvGpu once per requested iteration, and a post-loop synchronization precedes output retrieval.",
      "sha256": "9eef3af39199626a0ed1d063d849bfa64741fd4c1aeeeb54c1d409f1fa529c3a",
      "git_blob": "37def522a3da758f3efce85ad8c67ba7f38ba6d1"
    }
  ],
