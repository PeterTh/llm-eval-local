{
  "name": "llm-eval-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data:build": "tsx scripts/build-data.ts",
    "data:check": "tsx scripts/check-determinism.ts",
    "dev": "npm run data:build && vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run data:build && npm run typecheck && npm run test && npm run data:check",
    "build": "npm run data:build && tsc -b && vite build",
    "preview": "node scripts/serve-dist.ts",
    "test:e2e": "npm run build && node scripts/run-e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "csv-parse": "^7.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "vega": "^6.4.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
